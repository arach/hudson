{
  "name": "bunsen",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "concurrently \"vite --config vite.config.ts\" \"sleep 3 && NODE_ENV=development electrobun dev\"",
    "dev:vite": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts && electrobun build",
    "build:canary": "vite build --config vite.config.ts && electrobun build --env=canary",
    "build:stable": "vite build --config vite.config.ts && electrobun build --env=stable",
    "typecheck": "tsc --noEmit",
    "postinstall": "mkdir -p node_modules && ln -sf ../../../node_modules/electrobun node_modules/electrobun"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "lucide-react": "^0.574.0",
    "motion": "^12.34.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electrobun": "^1.14.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.0.0"
  }
}
