  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://hudsonkit.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/arach/hudson.git",
    "directory": "packages/web/hudsonkit"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:css",
    "build:js": "tsup && tsup --config tsup.theme.config.ts && tsup --config tsup.server.config.ts",
    "build:css": "tailwindcss -i src/styles/bundle.css -o dist/styles.css --minify && cp src/styles/tokens.css dist/tokens.css",
    "pack": "bun run build && bun pm pack",
    "prepare": "node bin/prepare-check.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.0",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "ai": "^6.0.0",
    "motion": "^12.0.0",
    "server-only": "^0.0.1"
  },
