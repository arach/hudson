{
  "name": "@hudsonkit/ai",
  "version": "0.2.2",
  "description": "Provider-neutral Backend interface, multi-step tool execution loop, and portable toolset registry for Hudson AI surfaces. Ships pi-ai, vercel-ai and scout (local agent harness) adapters.",
  "keywords": [
    "hudsonkit",
    "ai",
    "ai-sdk",
    "llm",
    "tools",
    "agent",
    "streaming"
  ],
  "homepage": "https://github.com/arach/hudson/tree/main/packages/web/ai-backends#readme",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pi-ai": {
      "types": "./dist/pi-ai.d.ts",
      "import": "./dist/pi-ai.js",
      "default": "./dist/pi-ai.js"
    },
    "./vercel-ai": {
      "types": "./dist/vercel-ai.d.ts",
      "import": "./dist/vercel-ai.js",
      "default": "./dist/vercel-ai.js"
    },
    "./scout": {
      "types": "./dist/scout.d.ts",
      "import": "./dist/scout.js",
      "default": "./dist/scout.js"
    },
    "./toolsets": {
      "types": "./dist/toolsets.d.ts",
      "import": "./dist/toolsets.js",
      "default": "./dist/toolsets.js"
    },
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "import": "./dist/conversation.js",
      "default": "./dist/conversation.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arach/hudson.git",
    "directory": "packages/web/ai-backends"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "ai": ">=6.0.0",
    "@openscout/agent-sessions": ">=0.2.78"
  },
  "peerDependenciesMeta": {
    "@openscout/agent-sessions": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "ai": "^6.0.0",
    "tsup": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
