  "scripts": {
    "build:css": "tailwindcss -i src/styles/bundle.css -o dist/styles.css --minify"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "lucide-react": "^0.564.0 || ^0.574.0"
