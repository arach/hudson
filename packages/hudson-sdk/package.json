{
  "name": "@hudson/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "HUD-style chrome components for canvas and panel-based applications",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shell": "./src/shell.ts",
    "./app-shell": "./src/app-shell.ts",
    "./chrome": "./src/chrome.ts",
    "./overlays": "./src/overlays.ts",
    "./context-menu": "./src/context-menu.ts",
    "./canvas": "./src/canvas.ts",
    "./windows": "./src/windows.ts",
