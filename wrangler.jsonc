{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hudsonkit",
  "account_id": "7f500c31ebdac9ae0271933b83f09722",
  "main": "site/cloudflare-static-worker.ts",
  "compatibility_date": "2026-04-30",
  "assets": {
    "directory": "site/out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "hudsonkit.com/*",
      "zone_name": "hudsonkit.com"
    },
    {
      "pattern": "www.hudsonkit.com/*",
      "zone_name": "hudsonkit.com"
    },
    {
      "pattern": "app.hudsonkit.com",
      "custom_domain": true
    }
  ]
}
