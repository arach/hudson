+        case "plan", "plan-doc", "plan-document":
+            self = .plan
+        case "diff", "patch", "review-diff", "running-diff":
+            self = .diff
+        case "preview", "app-preview", "browser-preview":
+            self = .preview
+        case "note", "markdown", "document":
+            self = .note
+        default:
+            self = .file
+        }
