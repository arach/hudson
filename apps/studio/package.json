{
  "name": "hudson-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Internal exploration lab for Hudson. Dogfoods hudsonkit primitives via the shared studio package.",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:ui": "vite --port 3033",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3033",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hudsonkit/paper": "link:../../packages/tools/hudson-paper",
    "hudsonkit": "link:../../packages/web/hudsonkit",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "studio": "link:../../../studio"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
