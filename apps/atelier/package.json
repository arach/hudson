{
  "name": "hudson-atelier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone Atelier — a Vite app that mounts HudsonKit's AppShell and WorkspaceShell as a plain consumer. Proves the kit is portable outside Hudson's Next host.",
  "scripts": {
    "dev": "vite --port 3034",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3034",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hudsonkit": "link:../../packages/web/hudsonkit",
    "lucide-react": "^0.574.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
