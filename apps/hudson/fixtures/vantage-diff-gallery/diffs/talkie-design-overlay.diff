+    // MARK: - Sidebar Style Lab Section
+
+    @AppStorage(SidebarStyleStorage.surfaceKey)   private var styleLabSurface:   String = SidebarSurfaceStyle.default.rawValue
+    @AppStorage(SidebarStyleStorage.indicatorKey) private var styleLabIndicator: String = SidebarIndicatorStyle.default.rawValue
