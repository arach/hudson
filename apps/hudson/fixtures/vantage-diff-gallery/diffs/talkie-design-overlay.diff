+
+    private var styleLabIsCustomized: Bool {
+        styleLabSurface   != SidebarSurfaceStyle.default.rawValue ||
+        styleLabIndicator != SidebarIndicatorStyle.default.rawValue ||
+        styleLabIcon      != SidebarIconStyle.default.rawValue ||
+        styleLabMotion    != SidebarMotionStyle.default.rawValue
+    }
+
+    @ViewBuilder
+    private var sidebarStyleLabSection: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            HStack(spacing: 6) {
+                Image(systemName: "paintpalette")
+                    .font(.system(size: 10))
+                    .foregroundColor(styleLabIsCustomized ? .pink : .white.opacity(0.5))
+
+                sectionHeader("Sidebar Style Lab")
+
+                Spacer()
+
+                if styleLabIsCustomized {
+                    Button(action: resetStyleLab) {
+                        Text("Reset")
+                            .font(.system(size: 8, weight: .medium))
+                            .foregroundColor(.white.opacity(0.85))
+                            .padding(.horizontal, 6)
+                            .padding(.vertical, 2)
+                            .background(
+                                RoundedRectangle(cornerRadius: 4)
+                                    .fill(Color.white.opacity(0.12))
+                            )
+                    }
+                    .buttonStyle(.plain)
+                }
+            }
+
+            stylePicker(
+                title: "Surface",
+                selection: $styleLabSurface,
+                options: SidebarSurfaceStyle.allCases.map { ($0.rawValue, $0.label) }
+            )
+
+            stylePicker(
+                title: "Indicator",
+                selection: $styleLabIndicator,
+                options: SidebarIndicatorStyle.allCases.map { ($0.rawValue, $0.label) }
+            )
+
+            stylePicker(
+                title: "Icon",
+                selection: $styleLabIcon,
+                options: SidebarIconStyle.allCases.map { ($0.rawValue, $0.label) }
+            )
+
+            stylePicker(
+                title: "Motion",
+                selection: $styleLabMotion,
+                options: SidebarMotionStyle.allCases.map { ($0.rawValue, $0.label) }
+            )
+        }
+    }
+
+    private func resetStyleLab() {
+        styleLabSurface   = SidebarSurfaceStyle.default.rawValue
+        styleLabIndicator = SidebarIndicatorStyle.default.rawValue
+        styleLabIcon      = SidebarIconStyle.default.rawValue
+        styleLabMotion    = SidebarMotionStyle.default.rawValue
+    }
+
+    @ViewBuilder
+    private func stylePicker(
+        title: String,
+        selection: Binding<String>,
+        options: [(value: String, label: String)]
+    ) -> some View {
+        HStack(alignment: .center, spacing: 6) {
+            Text(title)
+                .font(.system(size: 9))
+                .foregroundColor(.white.opacity(0.7))
+                .frame(width: inlineLabelWidth, alignment: .leading)
+
+            // Equal-width buttons that fill the remaining row.
+            HStack(spacing: 4) {
+                ForEach(options, id: \.value) { opt in
+                    let isActive = selection.wrappedValue == opt.value
+                    Button(action: { selection.wrappedValue = opt.value }) {
+                        Text(opt.label)
+                            .font(.system(size: 9, weight: .bold, design: .monospaced))
+                            .foregroundColor(isActive ? .black : .white.opacity(0.7))
+                            .lineLimit(1)
+                            .minimumScaleFactor(0.8)
+                            .frame(maxWidth: .infinity)
+                            .padding(.vertical, 3)
+                            .background(
+                                RoundedRectangle(cornerRadius: 4)
+                                    .fill(isActive ? Color.pink : Color.white.opacity(0.12))
+                            )
+                    }
+                    .buttonStyle(.plain)
+                }
+            }
+        }
+    }
