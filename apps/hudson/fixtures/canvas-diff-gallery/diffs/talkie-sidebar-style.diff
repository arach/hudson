+    @ViewBuilder
+    private var hoverBackground: some View {
+        if isHovering && !isSelected {
+            switch style.icon {
+            case .editorial:
+                EmptyView()
+            case .glass:
+                ZStack {
+                    RoundedRectangle(cornerRadius: 6)
