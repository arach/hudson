+                .padding(.horizontal, 4)
+                .padding(.vertical, 3)
+                .transition(.opacity.combined(with: .scale(scale: 0.94)))
+            case .kinetic:
+                RoundedRectangle(cornerRadius: 7)
+                    .fill(Color.white.opacity(0.06))
+                    .padding(.horizontal, 4)
+                    .padding(.vertical, 3)
