+    private var sidebarEdgeHandle: some View {
+        // Trailing-edge handle — drag to resize the expanded width, click to
+        // toggle compact mode. The hit zone is wider than the visual pill so
+        // users can grab it without aiming.
+        let isActive = edgeHandleHovered || edgeHandleDragging
+        return Rectangle()
+            .fill(Color.clear)
+            .frame(width: 8)
+            .contentShape(Rectangle())
+            .overlay(
+                RoundedRectangle(cornerRadius: 2)
+                    .fill(Theme.current.foreground.opacity(isActive ? 0.22 : 0.06))
+                    .frame(width: 3, height: isActive ? 36 : 28)
+                    .animation(.easeOut(duration: 0.15), value: isActive)
+            )
+            .cursor(sidebarIconsOnly ? .arrow : .resizeLeftRight)
+            .onHover { hovering in
+                withAnimation(.easeOut(duration: 0.15)) { edgeHandleHovered = hovering }
             }
-        }
-        .offset(x: 4)
+            .gesture(
+                DragGesture(minimumDistance: 2)
+                    .onChanged { value in
+                        if !edgeHandleDragging {
+                            edgeHandleDragging = true
+                            resizeDidDrag = false
+                            resizeDragStartWidth = expandedLabelWidth
+                        }
+                        // Resize is only meaningful when expanded.
+                        guard !sidebarIconsOnly else { return }
+                        resizeDidDrag = true
+                        let proposed = resizeDragStartWidth + Double(value.translation.width)
+                        let clamped = min(
+                            Self.sidebarMaxLabelWidth,
+                            max(Self.sidebarMinLabelWidth, proposed)
+                        )
+                        // Apply synchronously, no implicit animation — each
+                        // pointer move maps directly to a width change.
+                        var txn = Transaction(animation: nil)
+                        txn.disablesAnimations = true
+                        withTransaction(txn) {
+                            expandedLabelWidth = clamped
+                        }
+                    }
+                    .onEnded { _ in
+                        edgeHandleDragging = false
+                    }
+            )
+            .onTapGesture {
+                // Only treat as click-to-toggle if the gesture didn't drag.
+                if !resizeDidDrag { toggleSidebarRenderMode() }
+                resizeDidDrag = false
+            }
+            .help(
+                sidebarIconsOnly
+                    ? "Expand sidebar"
+                    : "Drag to resize · click to collapse"
+            )
+            .offset(x: 4)
