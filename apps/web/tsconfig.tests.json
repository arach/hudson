{
  // Typechecks the app + hudsonkit web test files that the root tsconfig excludes.
  // Relay tests are covered by packages/services/hudson-relay/tsconfig.json (own
  // ES2022/bundler settings + ambient shims); scripts are covered by
  // scripts/tsconfig.json (bun-executed, modern syntax).
  // Run with: bunx tsc -p tsconfig.tests.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "test/**/*",
    "app/**/__tests__/**/*",
    "../../packages/web/**/__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "../../packages/cloud",
    "embed-worker"
  ]
}
