{
  "name": "hudson-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3500",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export-pages": "bun site/export-pages.mjs",
    "embed:snapshot": "node embed-worker/scripts/snapshot-chunks.mjs",
    "embed:bundle": "node embed-worker/scripts/bundle-client.mjs",
    "embed:dev": "cd embed-worker && bunx wrangler dev --config wrangler.toml",
    "embed:deploy": "bun run embed:bundle && bun run embed:snapshot && cd embed-worker && bun run deploy",
    "cf:deploy": "bunx wrangler deploy",
    "cf:upload": "bunx wrangler versions upload"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
