    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.0",
    "archiver": "^7.0.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.27.3",
    "fonteditor-core": "^2.6.3",
    "gifenc": "^1.0.3",
