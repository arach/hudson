{
  "name": "hudson",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --filter @hudsonkit/ai build && bun run --filter hudsonkit build && next dev --port 3500",
    "dev:safe": "bun scripts/dev-guard.ts",
    "build": "bun run --filter @hudsonkit/ai build && bun run --filter hudsonkit build && next build",
    "build:site": "bun run build && bun run embed:bundle && bun site/export-pages.mjs",
    "deploy:hudsonkit": "bun run build:site && bunx wrangler deploy",
    "upload:hudsonkit": "bun run build:site && bunx wrangler versions upload",
    "embed:snapshot": "node embed-worker/scripts/snapshot-chunks.mjs",
    "embed:bundle": "node embed-worker/scripts/bundle-client.mjs",
    "embed:dev": "cd embed-worker && bunx wrangler dev --config wrangler.toml",
    "embed:deploy": "bun run embed:bundle && bun run embed:snapshot && cd embed-worker && bun run deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "relay": "node --no-warnings --import tsx packages/services/hudson-relay/src/index.ts",
    "relay:legacy": "node --no-warnings scripts/ai-relay.ts",
    "dev:studio": "bun run --filter hudsonkit build && bun --cwd apps/studio dev",
    "build:native-editor": "mkdir -p packages/native/apple/HudsonKit/Sources/HudsonVantageSurface/Resources/HudsonCodeEditor && cp packages/web/hudsonkit/src/native/code-editor-webview.html packages/native/apple/HudsonKit/Sources/HudsonVantageSurface/Resources/HudsonCodeEditor/index.html && bun build packages/web/hudsonkit/src/native/code-editor-webview.ts --target=browser --format=iife --minify --outfile=packages/native/apple/HudsonKit/Sources/HudsonVantageSurface/Resources/HudsonCodeEditor/editor.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/react": "^3.0.107",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@google/genai": "^1.42.0",
    "@lezer/highlight": "^1.2.3",
    "@libsql/client": "^0.17.0",
    "@pierre/diffs": "^1.1.20",
    "@shikijs/rehype": "^3.22.0",
    "@types/archiver": "^7.0.0",
    "@voxd/client": "^0.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.105",
    "archiver": "^7.0.1",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.1",
    "esbuild": "^0.27.3",
    "fonteditor-core": "^2.6.3",
    "gifenc": "^1.0.3",
    "gray-matter": "^4.0.3",
    "html2canvas-pro": "^2.0.2",
    "lucide-react": "^0.574.0",
    "motion": "^12.34.3",
    "next": "16.1.6",
    "node-pty": "1.2.0-beta.12",
    "opentype.js": "^1.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "shiki": "^3.22.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "workspaces": [
    "packages/tools/create-hudson-app",
    "packages/tools/hkit",
    "packages/services/hudson-relay",
    "packages/web/ai-backends",
    "packages/web/hudsonkit",
    "packages/web/hudson-showroom"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "@hudsonkit/ai": "workspace:*",
    "hudsonkit": "workspace:*",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
