#!/usr/bin/env bash
# HudLint pre-commit hook. Skips silently when HudsonKit Apple sources aren't touched.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
KIT_DIR="$REPO_ROOT/packages/native/apple/HudsonKit"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^packages/native/apple/HudsonKit/(Sources|Demo)/.*\.swift$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

HUDLINT="$KIT_DIR/Tools/HudLint/.build/release/hudlint"
if [ ! -x "$HUDLINT" ]; then
  echo "hudlint binary missing - building..."
  (cd "$KIT_DIR/Tools/HudLint" && swift build -c release --product hudlint > /dev/null 2>&1)
fi

# Lint at the Sources/Demo root, not each staged file's directory. hudlint
# resolves .hudlintignore from <root>/../.hudlintignore and matches its patterns
# relative to <root>, so both allowlist discovery and pattern matching only work
# when the root is Sources (or Demo). Per-directory roots silently defeat the
# allowlist and resurface deferred token-migration debt.
# (if/[[ ]] rather than case — bash 3.2 mis-parses case-pattern `)` inside $(...).)
LINT_ROOTS=$(
  echo "$STAGED" | while IFS= read -r file; do
    if [[ "$file" == packages/native/apple/HudsonKit/Sources/* ]]; then
      echo "$KIT_DIR/Sources"
    elif [[ "$file" == packages/native/apple/HudsonKit/Demo/* ]]; then
      echo "$KIT_DIR/Demo"
    fi
  done | sort -u
)

while IFS= read -r root; do
  [ -n "$root" ] || continue
  "$HUDLINT" --root "$root" --format plain
done <<< "$LINT_ROOTS"
